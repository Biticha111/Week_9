<!-- Page header banner -->
<div class="bg-info mb-4 pt-4 m-3 p-5 rounded-3 text-center">
    <h1>Please provide feedback. You may do so anonymously</h1>
</div>

<!-- Main two-column layout -->
<div class="row">

    <!-- Left column: Form instructions -->
    <div class="col-md-5">
        <h2>Instructions</h2>
        <p>As one of our students, your thoughts, feedback and comments are important to us.</p>
        <p>Please send them using this form.</p>
        <p>If you would like us to follow up with you, include your contact information.</p>
    </div>

    <!-- Right column: Feedback submission form -->
    <div class="col-md-7">
        <form action="/submit_feedback" method="POST">

            <!-- Name input -->
            <label class="form-label" for="name">Name</label>
            <input class="form-control" id="name" type="text" name="name">

            <br>

            <!-- Email input -->
            <label class="form-label" for="email">Email</label>
            <p class="m-2">If you would like us to follow up with you</p>
            <input class="form-control" id="email" type="email" name="email">

            <br>

            <!-- Comments textarea (required) -->
            <label class="form-label" for="comments">Comments</label>
            <textarea class="form-control" id="comments" name="comments" required></textarea>

            <br>

            <!-- Student status radio buttons -->
            <p class="m-2">Are you a current student?</p>

            <div class="form-check">
                <input class="form-check-input" id="yes" type="radio" value="yes" name="isCurrentStudent">
                <label class="form-check-label" for="yes">Yes</label>
            </div>

            <div class="form-check">
                <input class="form-check-input" id="no" type="radio" value="no" name="isCurrentStudent">
                <label class="form-check-label" for="no">No</label>
            </div>

            <br>

            <!-- Submit button -->
            <input class="btn btn-dark" type="submit">

        </form>
    </div>
</div>
